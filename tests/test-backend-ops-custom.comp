#version 450

// the Vulkan kernel of test_custom_op in test-backend-ops.cpp, CMake compiles it to SPIR-V (glslc)

layout(local_size_x_id = 0) in;

layout(push_constant) uniform test_custom_op_params {
    float a;
    int   n;
} p;

layout(binding = 0) writeonly buffer D { float dst[]; };
layout(binding = 1) readonly  buffer X { float x[]; };
layout(binding = 2) readonly  buffer Y { float y[]; };

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < uint(p.n)) {
        dst[i] = p.a*x[i] + y[i];
    }
}
