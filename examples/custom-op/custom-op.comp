#version 450

// the Vulkan kernel of the saxpy op in custom-op.cpp, CMake compiles it to SPIR-V (glslc)

// the size of a workgroup that the kernel tells: the specialization constants 0, 1 and 2 (x, y and z)
layout(local_size_x_id = 0) in;

// the params
layout(push_constant) uniform saxpy_params {
    float a;
    int   n;
} p;

// the data of the node, then the data of its arguments
layout(binding = 0) writeonly buffer D { float dst[]; };
layout(binding = 1) readonly  buffer X { float x[]; };
layout(binding = 2) readonly  buffer Y { float y[]; };

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < uint(p.n)) {
        dst[i] = p.a*x[i] + y[i];
    }
}
